config modbus_sim 'main'
	option enabled '0'
	option config '/etc/modbus-sim/config.yaml'
	# tcp | rtu
	option mode 'tcp'
	option host '0.0.0.0'
	option port '502'
	# RTU settings (mode rtu)
	option serial_port '/dev/ttyUSB0'
	option baudrate '9600'
	option bytesize '8'
	# N | E | O
	option parity 'N'
	option stopbits '1'
	# rtu | ascii
	option framer 'rtu'
	option handle_local_echo '0'
	option debug_requests '0'
	# DEBUG | INFO | WARNING | ERROR
	option log_level 'INFO'
