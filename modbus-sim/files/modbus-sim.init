#!/bin/sh /etc/rc.common
# Modbus slave simulator (procd). Settings: /etc/config/modbus-sim
# Logs: logread -e modbus-sim

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/modbus-sim

start_service() {
	local enabled config mode host port serial_port baudrate bytesize parity stopbits
	local framer handle_local_echo debug_requests log_level

	config_load modbus-sim
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0

	config_get config main config /etc/modbus-sim/config.yaml
	config_get mode main mode tcp
	config_get host main host 0.0.0.0
	config_get port main port 502
	config_get serial_port main serial_port /dev/ttyUSB0
	config_get baudrate main baudrate 9600
	config_get bytesize main bytesize 8
	config_get parity main parity N
	config_get stopbits main stopbits 1
	config_get framer main framer rtu
	config_get_bool handle_local_echo main handle_local_echo 0
	config_get_bool debug_requests main debug_requests 0
	config_get log_level main log_level INFO

	procd_open_instance
	procd_set_param command "$PROG" "$config" --mode "$mode" --log-level "$log_level"
	if [ "$mode" = rtu ]; then
		procd_append_param command --serial-port "$serial_port" --baudrate "$baudrate" \
			--bytesize "$bytesize" --parity "$parity" --stopbits "$stopbits" \
			--rtu-framer "$framer"
		[ "$handle_local_echo" = 1 ] && procd_append_param command --handle-local-echo
	else
		procd_append_param command --host "$host" --port "$port"
	fi
	[ "$debug_requests" = 1 ] && procd_append_param command --debug-requests
	procd_set_param file "$config"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger modbus-sim
}
